{
  "name": "cellarsnap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:web && npm run lint:mobile",
    "lint:web": "eslint --max-warnings 0",
    "lint:mobile": "npm run lint --prefix apps/mobile",
    "test:primitives": "E2E_BASE_URL=http://127.0.0.1:3000 playwright test e2e/phase6-primitives.spec.ts",
    "test:routes": "E2E_BASE_URL=http://127.0.0.1:3000 playwright test e2e/phase6-route-handlers.spec.ts",
    "eval:lineup": "node scripts/eval-lineup-label-scan.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "exifreader": "^4.36.1",
    "next": "16.1.6",
    "openai": "^6.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "supabase": "^2.78.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
